# Copy this file to .env and fill in the values. Never commit .env.

# --- Language model (any OpenAI-compatible chat API) ---
# Groq is fast, which matters for a voice call. Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Check what's currently available with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_MODEL=openai/gpt-oss-20b
# For reasoning models (like gpt-oss) keep thinking short so replies come back fast.
# Leave empty for non-reasoning models.
LLM_REASONING_EFFORT=low

# Gemini instead (free tier at https://aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<a current Flash model id>
# LLM_REASONING_EFFORT=

# --- Telegram bot for alerts ---
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=

# How long a shared live location stays live, in seconds (60 to 86400).
LIVE_LOCATION_SECONDS=3600
# Time zone used in messages to contacts.
TIMEZONE=Asia/Kolkata
